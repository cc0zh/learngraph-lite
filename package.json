{
  "name": "mini-learngraph4",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "code-harness-init": "./scripts/create-project.cjs"
  },
  "scripts": {
    "ci": "node scripts/ci.cjs",
    "test": "node --test tests/tooling.test.cjs && uv run --locked python scripts/run-python-tests.py",
    "check:docs": "node scripts/check-docs.cjs",
    "check:repo": "node scripts/check-repo-hygiene.cjs",
    "check:actions": "node scripts/check-action-pinning.cjs",
    "release-package": "node scripts/release-package.cjs",
    "test:py": "uv run --locked python scripts/run-python-tests.py",
    "dev:api": "uv run --locked uvicorn learngraph_lite.bootstrap:create_fixture_app --factory --app-dir src --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 2",
    "check:py-boundaries": "python scripts/check-python-boundaries.py",
    "smoke:fixture": "python scripts/run-fixture-smoke.py",
    "eval:offline": "python evals/run.py",
    "demo:fixture": "python scripts/run-fixture-demo.py"
  }
}
